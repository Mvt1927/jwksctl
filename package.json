{
	"name": "jwksctl",
	"version": "1.0.3",
	"description": "Production-grade CLI for JWKS lifecycle management, key rotation, signing, and verification",
	"author": "Mvt1927",
	"license": "MIT",
	"keywords": [
		"jwks",
		"jwt",
		"crypto",
		"security",
		"key-rotation",
		"rfc7517",
		"cli",
		"bun"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Mvt1927/jwksctl.git"
	},
	"bugs": {
		"url": "https://github.com/Mvt1927/jwksctl/issues"
	},
	"homepage": "https://github.com/Mvt1927/jwksctl#readme",
	"files": [
		"src",
		"index.ts",
		"README.md",
		"install.sh"
	],
	"module": "index.ts",
	"type": "module",
	"bin": {
		"jwksctl": "./index.ts"
	},
	"scripts": {
		"start": "bun run index.ts",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"build": "bun build ./index.ts --compile --outfile dist/jwksctl",
		"build:linux-x64": "bun build ./index.ts --compile --target=bun-linux-x64 --outfile dist/jwksctl-linux-x64",
		"build:linux-arm64": "bun build ./index.ts --compile --target=bun-linux-arm64 --outfile dist/jwksctl-linux-arm64",
		"build:windows-x64": "bun build ./index.ts --compile --target=bun-windows-x64 --outfile dist/jwksctl-windows-x64.exe",
		"build:darwin-x64": "bun build ./index.ts --compile --target=bun-darwin-x64 --outfile dist/jwksctl-darwin-x64",
		"build:darwin-arm64": "bun build ./index.ts --compile --target=bun-darwin-arm64 --outfile dist/jwksctl-darwin-arm64",
		"build:all": "bun run build:linux-x64 && bun run build:linux-arm64 && bun run build:windows-x64 && bun run build:darwin-x64 && bun run build:darwin-arm64",
		"lint": "eslint --max-warnings=0 src tests index.ts",
		"lint:fix": "eslint --fix src tests index.ts && prettier --write .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"prepare": "husky"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/bun": "latest",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.10",
		"typescript-eslint": "^8.71.1"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"@clack/prompts": "^1.8.1",
		"commander": "^15.0.0",
		"jose": "^6.2.12",
		"mongodb": "^7.7.0",
		"picocolors": "^1.1.1"
	},
	"lint-staged": {
		"*.{ts,js,mjs,cjs}": [
			"eslint --fix --max-warnings=0",
			"prettier --write"
		],
		"*.{json,md,yml,yaml}": [
			"prettier --write"
		]
	}
}
